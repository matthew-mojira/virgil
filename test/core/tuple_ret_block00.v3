//@execute 0=2; 3=31; 5=51
def sel(x: int) -> (int, int) {
	// the if/else merge carries the tuple result, so the block is emitted with
	// a typed (multi-value) block type rather than a value type
	if (x > 2) return (x, 1);
	return (x, 2);
}
def main(a: int) -> int {
	var r = sel(a);
	return r.0 * 10 + r.1;
}
