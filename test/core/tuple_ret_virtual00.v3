//@execute 0=1; 1=2; 2=13
class Base {
	def pair(x: int) -> (int, int) { return (x, x + 1); }
}
class Derived extends Base {
	def pair(x: int) -> (int, int) { return (x + 10, x + 11); }
}
def main(a: int) -> int {
	var b: Base = if(a == 2, Derived.new(), Base.new());
	// virtual dispatch returning a tuple, with the first component dropped
	return b.pair(a).1;
}
