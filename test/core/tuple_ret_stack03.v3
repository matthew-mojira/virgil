//@execute 0=0; 3=12; 5=35
def pair(x: int) -> (int, int) {
	return (x + 1, x * 10);
}
def main(a: int) -> int {
	// the same shape inside a loop body: a live pre-call value combined with a
	// projection, repeated across back-edges
	var acc = 0;
	for (i < a) {
		var x = i * 2;
		var r = pair(i);
		acc = r.0 + x + acc;
	}
	return acc;
}
